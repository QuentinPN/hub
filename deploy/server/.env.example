# À copier en deploy/server/.env (droits 600, ignoré par git), ou à coller dans le .env de la stack
# Dockhand « hub ».

# Versions des images sur GHCR. Facultatif : latest par défaut. X.Y.Z (ou X.Y, X) pour fixer ou
# revenir en arrière ; sha-<court> existe aussi. Une par image : chacune n'est republiée que si ses
# fichiers changent, hub-caddy peut donc rester à 1.0.0 pendant que hub-server est à 1.4.0.
# HUB_TAG=latest
# HUB_CADDY_TAG=latest

# openssl rand -hex 32 (hexadécimal : le mot de passe entre tel quel dans une URL)
HUB_DB_PASSWORD=

# Nom de l'UI, servie sur le port 8444. Les passkeys y sont liées définitivement.
HUB_DOMAIN=home.example.com

# IP de l'hôte sur laquelle publier les ports 8443 et 8444, jamais 0.0.0.0.
HUB_BIND=192.0.2.14

# Ce que les agents appellent. Le premier nom est celui que montre l'écran d'enrôlement ;
# « hub » sert à l'agent de ce même hôte (agent/compose.same-host.yml).
HUB_AGENT_NAMES=192.0.2.14,hub

# Token Cloudflare limité à Zone > DNS > Edit sur example.com, pour le certificat.
CLOUDFLARE_API_TOKEN=

# Sauvegardes de Hub. off : aucune, ni seule ni à la main, et la section le dit.
# Pour les activer : retirer cette ligne, monter un partage du QNAP (docs/EXPLOITATION.md,
# « Le dossier de destination »), puis décommenter les deux lignes suivantes.
HUB_BACKUP=off
# HUB_BACKUP_HOST_DIR=/mnt/hub-sauvegardes
# COMPOSE_FILE=compose.yml:compose.backup.yml

# Fuseau du créneau de sauvegarde (03:00), tant que Réglages → Général n'en choisit pas un autre.
TZ=Europe/Paris

# Nom de cette machine, affiché dans Réglages → Général → À propos. Facultatif.
HUB_HOST_NAME=GEEKOM IT13 (mini-PC)
