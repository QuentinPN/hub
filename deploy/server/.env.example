# À copier en deploy/server/.env (droits 600, ignoré par git).

# openssl rand -hex 32 (hexadécimal : le mot de passe entre tel quel dans une URL)
HUB_DB_PASSWORD=

# Adresse publique de l'UI. Les passkeys y sont liées définitivement.
HUB_ORIGIN=https://home.example.com

# IP de l'hôte sur laquelle publier le port agents, jamais 0.0.0.0.
HUB_AGENT_BIND=192.0.2.14

# Ce que les agents appellent. Le premier nom est celui que montre l'écran d'enrôlement ;
# « hub » sert à l'agent de ce même hôte (agent/compose.same-host.yml).
HUB_AGENT_NAMES=192.0.2.14,hub

# Réseau Docker du Caddy existant : docker inspect <conteneur caddy> --format '{{json .NetworkSettings.Networks}}'
HUB_CADDY_NETWORK=
